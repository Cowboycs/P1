# ── 앱 주소 (배포 후 실제 도메인으로) ─────────────────────
NEXT_PUBLIC_APP_URL=https://fittrainer.vercel.app

# ── Supabase ───────────────────────────────────────────────
# URL·publishable 키는 lib/supabase/config.ts 에 들어 있음 (fittrainer 프로젝트)
# Vercel Supabase 연동이 만드는 NEXT_PUBLIC_SUPABASE_* 변수는 사용하지 않음
# 서버 전용 비밀 키: Supabase 대시보드(fittrainer) > Project Settings > API Keys > Secret keys
FT_SUPABASE_SECRET_KEY=

# ── Claude (AI 일지) ───────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── 토스페이먼츠 자동결제 ──────────────────────────────────
# 테스트: test_ck_ / test_sk_  →  운영: live_ck_ / live_sk_ (빌링 계약 후)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 솔라피 알림톡 (비워 두면 '시뮬레이션 발송'으로 동작) ────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
SOLAPI_SENDER=
SOLAPI_TEMPLATE_REPORT=
SOLAPI_TEMPLATE_REMAIN=

# ── 정기결제 크론 보호 ─────────────────────────────────────
CRON_SECRET=

# ── 사업자 정보 (PG 심사 필수 표기) ─────────────────────────
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_CEO=
NEXT_PUBLIC_BIZ_NO=
NEXT_PUBLIC_BIZ_MAILORDER_NO=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_EMAIL=
